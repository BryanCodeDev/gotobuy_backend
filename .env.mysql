# ==============================================
# ARCHIVO VARIABLES MYSQL RAILWAY
# ==============================================
# Estas variables se configuran automáticamente en Railway
# al crear el servicio MySQL, no tienes que añadirlas manualmente

MYSQL_DATABASE=railway
MYSQL_ROOT_PASSWORD=${{MYSQL_ROOT_PASSWORD}}
MYSQL_USER=root
MYSQL_PASSWORD=${{MYSQL_ROOT_PASSWORD}}

# Conexión PÚBLICA (fuera de Railway)
MYSQL_PUBLIC_URL=mysql://${{MYSQLUSER}}:${{MYSQL_ROOT_PASSWORD}}@${{RAILWAY_TCP_PROXY_DOMAIN}}:${{RAILWAY_TCP_PROXY_PORT}}/${{MYSQL_DATABASE}}

# Conexión PRIVADA (dentro de Railway, entre servicios)
MYSQL_URL=mysql://${{MYSQLUSER}}:${{MYSQL_ROOT_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:3306/${{MYSQL_DATABASE}}

# Variables nativas Railway
MYSQLHOST=${{RAILWAY_PRIVATE_DOMAIN}}
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=${{MYSQL_ROOT_PASSWORD}}
MYSQLDATABASE=railway

# ==============================================
# CONFIGURACIÓN OPTIMIZADA MYSQL 9.4 RAILWAY
# ==============================================
MYSQLD_ARGS=--innodb-buffer-pool-size=256M --performance-schema=0 --innodb-use-native-aio=0 --disable-log-bin
MYSQLD_CHROOT=0
MYSQLD_EXTRA_SECURE_FILE_PRIV=
MYSQLD_GENERAL_LOG=0
MYSQLD_SLOW_QUERY_LOG=0

# ==============================================
# CARACTERÍSTICAS Y CODIFICACIÓN
# ==============================================
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_INIT_CONNECT='SET NAMES utf8mb4'