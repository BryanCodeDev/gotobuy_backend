# ==============================================
# ARCHIVO .env BACKEND RAILWAY - PRODUCCIÓN
# ==============================================
# Este archivo va en la carpeta /backend
# Todas las variables se configuran en Railway Dashboard

NODE_ENV=production

# ==============================================
# BASE DE DATOS MYSQL RAILWAY
# ==============================================
# Railway inyecta estas variables AUTOMÁTICAMENTE cuando vinculas MySQL
# No necesitas editarlas manualmente
DB_HOST=${{RAILWAY_PRIVATE_DOMAIN}}
DB_USER=root
DB_PASSWORD=${{DB_PASSWORD}}
DB_NAME=railway
DB_PORT=3306

# Variables nativas Railway MySQL (se inyectan automáticamente)
MYSQLHOST=${{RAILWAY_PRIVATE_DOMAIN}}
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=${{MYSQL_ROOT_PASSWORD}}
MYSQLDATABASE=railway

# ==============================================
# AUTENTICACIÓN
# ==============================================
JWT_SECRET=${{JWT_SECRET}}

# ==============================================
# MERCADO PAGO
# ==============================================
MERCADO_PAGO_ACCESS_TOKEN=${{MERCADO_PAGO_ACCESS_TOKEN}}
MERCADO_PAGO_PUBLIC_KEY=${{MERCADO_PAGO_PUBLIC_KEY}}
MERCADO_PAGO_CLIENT_ID=${{MERCADO_PAGO_CLIENT_ID}}
MERCADO_PAGO_CLIENT_SECRET=${{MERCADO_PAGO_CLIENT_SECRET}}

# ==============================================
# URLS APLICACIÓN
# ==============================================
FRONTEND_URL=${{FRONTEND_URL}}
BACKEND_URL=${{BACKEND_URL}}

# ==============================================
# PUERTO SERVIDOR
# ==============================================
PORT=${{PORT}}

# ==============================================
# CONFIGURACIÓN BASE DE DATOS
# ==============================================
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=30000
DB_ACQUIRE_TIMEOUT=60000
DB_TIMEOUT=60000